# ==============================================================================
# GeoFace Production Environment Variables Template
# Copy this file to .env and fill in the values
# ==============================================================================

# ── Flask API ─────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=y0ur-v3ry-str0ng-secr3t-k3y-h3r3
JWT_SECRET_KEY=y0ur-v3ry-str0ng-jwt-k3y-h3r3
PORT=5000

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=geoface_admin
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=geoface_prod
DATABASE_URL=postgresql://geoface_admin:choose-a-strong-password@db:5432/geoface_prod

# ── Geofencing Configuration ──────────────────────────────────────────────────
# LPU Punjab Precision Polygon (JSON list of [lat, lon] pairs)
GEOFENCE_POLYGON="[[31.26046,75.70661],...]"
GEOFENCE_BUFFER_METERS=15
COLLEGE_LATITUDE=31.2536
COLLEGE_LONGITUDE=75.7037

# ── Initial Admin Credentials ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=InitialAdminPassword123!

# ── CORS & Security ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:8080

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Gunicorn Configuration ────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info
GUNICORN_TIMEOUT=120



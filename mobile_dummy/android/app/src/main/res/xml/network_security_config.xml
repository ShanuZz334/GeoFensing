<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config for GeoFace Auth.
    Enforces HTTPS-only in release builds.
    For debug testing against a local dev server, uncomment the debug block.
-->
<network-security-config>
    <!-- Production: require HTTPS for all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
    Uncomment during development only (Android emulator → localhost):

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    -->
</network-security-config>
